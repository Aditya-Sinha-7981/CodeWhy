# Local planning material and machine-specific files
/local/
.DS_Store

# Python environments, build products, and test/tool caches
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
# Anchored to the repo root so committed test fixtures named build/ or dist/
# (used by ignore tests in later tasks) are not swallowed.
/build/
/dist/

# codewhy's per-scanned-project cache
.codewhy/

# Local credentials and configuration overrides
.env
.env.*
!.env.example

# codewhy evaluation runs (raw model answers; never committed)
/eval/runs/
